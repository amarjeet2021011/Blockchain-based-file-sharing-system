# Pinata credentials (https://app.pinata.cloud/developers/api-keys)
# Use either a JWT (recommended) ...
VITE_PINATA_JWT=
# ... or an API key + secret pair
VITE_PINATA_API_KEY=
VITE_PINATA_API_SECRET=

# Gateway used to open files (your dedicated Pinata gateway works too)
VITE_IPFS_GATEWAY=https://gateway.pinata.cloud

# Optional: override the contract address from src/contract/addresses.json
VITE_CONTRACT_ADDRESS=
